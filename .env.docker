DATABASE_URL="mysql://root:qwer1234@mysql:3306/ai_admin"

REDIS_HOST="redis"
REDIS_PORT=6379

JWT_ACCESS_SECRET="xiaoyao_ai_admin_access_secret"
JWT_ACCESS_EXPIRES_IN="30m"

JWT_REFRESH_SECRET="xiaoyao_ai_admin_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

APP_URL="http://localhost:3000"

# 容器内访问宿主机 Ollama（Windows / Mac / Linux host-gateway）
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b

AI_CACHE_TTL=86400

# 前端仍在本机 3001 开发/访问时
CORS_ORIGIN="http://localhost:3001"

# 向量库（Docker 内服务名 qdrant）
QDRANT_URL=http://qdrant:6333
# 跳过启动时 Ollama embed 探测（nomic-embed-text 维度）
EMBED_VECTOR_SIZE=768