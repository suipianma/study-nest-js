DATABASE_URL="mysql://root:qwer1234@localhost:3306/ai_admin"

REDIS_HOST="localhost"
REDIS_PORT=6379

JWT_ACCESS_SECRET="xiaoyao_ai_admin_access_secret"
JWT_ACCESS_EXPIRES_IN="30m"

JWT_REFRESH_SECRET="xiaoyao_ai_admin_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

APP_URL="http://localhost:3000"

CORS_ORIGIN="http://localhost:3001"

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_THINK=false
WEATHER_API_KEY=
# 天气：默认用 wttr.in（无需 Key）；配置 WEATHER_API_KEY 后优先 OpenWeather
# 推荐日常对话：OLLAMA_MODEL=qwen3:8b

# AI 回复 Redis 缓存 TTL（秒），默认 24 小时
AI_CACHE_TTL=86400

MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_ROOTS=../docs,./uploads/kb